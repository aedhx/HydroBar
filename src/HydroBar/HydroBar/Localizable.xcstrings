    "Not sure? Get a suggestion from your weight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsicher? Lass dir anhand deines Gewichts einen Vorschlag machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No estás seguro? Obtén una sugerencia según tu peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous hésitez ? Obtenez une suggestion à partir de votre poids."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sei sicuro? Ottieni un suggerimento in base al tuo peso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "迷ったら、体重から目安を提案します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twijfel je? Krijg een suggestie op basis van je gewicht."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não tem certeza? Receba uma sugestão com base no seu peso."
