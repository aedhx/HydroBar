    "A Focus is on: reminders appear as a badge.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fokus ist aktiv: Erinnerungen erscheinen als Kennzeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un modo de concentración activo: los recordatorios aparecen como insignia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une concentration est active : les rappels s'affichent en pastille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È attiva una modalità Full immersion: i promemoria appaiono come badge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中モードがオンです：リマインダーはバッジで表示されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een focus actief: herinneringen verschijnen als badge."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um modo de foco está ativo: os lembretes aparecem como selo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注模式已开启：提醒将以标记显示。"
          }
        }
      }
    },
    "A deep link is asking to reset today's intake to zero.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Deep Link möchte die heutige Trinkmenge auf null setzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace profundo quiere poner a cero el consumo de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien profond demande de remettre à zéro la consommation du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un deep link chiede di azzerare il consumo di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディープリンクが今日の摂取量をゼロにリセットしようとしています。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een deeplink wil de inname van vandaag op nul zetten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link direto quer zerar o consumo de hoje."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个深层链接请求将今天的饮水量清零。"
          }
        }
      }
    },
