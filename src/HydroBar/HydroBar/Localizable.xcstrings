    "%@ left to reach your goal today.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %@ bis zu deinem Tagesziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te quedan %@ para alcanzar tu objetivo de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore %@ pour atteindre votre objectif du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancano %@ per raggiungere l'obiettivo di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の目標まであと %@。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog %@ om je doel van vandaag te halen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam %@ para atingir seu objetivo de hoje."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离今天的目标还差 %@。"
          }
        }
      }
    },
    "%@ of %@ · %@ to go by %@.": {
      "localizations": {
