        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ était illisible et a été mis de côté sous le nom %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non era leggibile ed è stato messo da parte come %2$@."
