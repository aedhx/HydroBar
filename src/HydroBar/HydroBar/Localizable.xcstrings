    "You can give each preset a global keyboard shortcut in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Einstellungen kannst du jeder Voreinstellung ein globales Tastenkürzel zuweisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Configuración puedes asignar a cada preajuste un atajo de teclado global."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les Réglages, vous pouvez donner à chaque preset un raccourci clavier global."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelle Impostazioni puoi assegnare a ogni preset una scorciatoia da tastiera globale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で各プリセットにグローバルなキーボードショートカットを割り当てられます。"
          }
        },
        "nl": {
