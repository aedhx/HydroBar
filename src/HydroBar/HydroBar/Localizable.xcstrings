    "HydroBar": {
      "comment": "App name",
      "shouldTranslate": false
    },
    "HydroBar can remind you to drink when you haven't logged anything for a while. macOS will ask for your permission.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroBar kann dich ans Trinken erinnern, wenn du eine Weile nichts eingetragen hast. macOS fragt nach deiner Erlaubnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroBar puede recordarte que bebas cuando lleves un rato sin registrar nada. macOS te pedirá permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroBar peut vous rappeler de boire quand vous n'avez rien enregistré depuis un moment. macOS vous demandera votre autorisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroBar può ricordarti di bere quando non registri nulla da un po'. macOS ti chiederà il permesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらく記録がないとき、HydroBar が水分補給を知らせます。macOS が許可を求めます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroBar kan je eraan herinneren te drinken als je een tijdje niets hebt ingevoerd. macOS vraagt om je toestemming."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O HydroBar pode lembrar você de beber quando não registrar nada por um tempo. O macOS pedirá sua permissão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你一段时间没有记录，HydroBar 可以提醒你喝水。macOS 会请求你的许可。"
          }
        }
      }
    },
