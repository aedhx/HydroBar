    "While an app uses your microphone or camera, reminders wait for the call to end.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange eine App Mikrofon oder Kamera nutzt, warten Erinnerungen bis zum Ende des Anrufs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras una app usa el micrófono o la cámara, los recordatorios esperan a que acabe la llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant qu'une app utilise votre micro ou votre caméra, les rappels attendent la fin de l'appel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre un'app usa il microfono o la fotocamera, i promemoria aspettano la fine della chiamata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがマイクやカメラを使っている間、リマインダーは通話の終了を待ちます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang een app je microfoon of camera gebruikt, wachten herinneringen tot het gesprek voorbij is."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto um app usa o microfone ou a câmera, os lembretes esperam a chamada terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当有 App 使用麦克风或摄像头时，提醒会等到通话结束。"
          }
        }
      }
    },
    "Without its own goal, a day off uses your goal for that day of the week.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne eigenes Ziel nutzt ein freier Tag das Ziel dieses Wochentags."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin objetivo propio, un día libre usa el objetivo de ese día de la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans objectif propre, un jour off prend l'objectif de ce jour de la semaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza un obiettivo proprio, un giorno libero usa quello di quel giorno della settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個別の目標がない場合、休日はその曜日の目標を使います。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder eigen doel gebruikt een vrije dag het doel van die dag van de week."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem objetivo próprio, um dia de folga usa o objetivo daquele dia da semana."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若无单独目标，休息日使用该星期几的目标。"
          }
        }
      }
    },
