    "Makes today a work day or a day off in HydroBar. Days off use their own hours, reminders and goal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht heute in HydroBar zu einem Arbeitstag oder freien Tag. Freie Tage haben eigene Zeiten, Erinnerungen und ein eigenes Ziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte hoy en día laborable o día libre en HydroBar. Los días libres tienen sus propias horas, recordatorios y objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait d'aujourd'hui un jour de travail ou un jour off dans HydroBar. Les jours off ont leur plage, leurs rappels et leur objectif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rende oggi un giorno lavorativo o libero in HydroBar. I giorni liberi hanno orari, promemoria e obiettivo propri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroBar で今日を仕事の日または休日にします。休日には独自の時間帯、リマインダー、目標があります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt vandaag een werkdag of vrije dag in HydroBar. Vrije dagen hebben eigen uren, herinneringen en doel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna hoje um dia de trabalho ou de folga no HydroBar. Dias de folga têm horários, lembretes e objetivo próprios."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 HydroBar 中将今天设为工作日或休息日。休息日有自己的时段、提醒和目标。"
          }
        }
      }
    },
