    "Your usual settings describe a work day. Days off can start later, remind you less often and have their own goal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine üblichen Einstellungen beschreiben einen Arbeitstag. Freie Tage können später beginnen, seltener erinnern und ein eigenes Ziel haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus ajustes habituales describen un día laborable. Los días libres pueden empezar más tarde, recordarte menos y tener su propio objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réglages habituels décrivent un jour de travail. Les jours off peuvent commencer plus tard, vous rappeler moins souvent et avoir leur propre objectif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni abituali descrivono un giorno lavorativo. I giorni liberi possono iniziare più tardi, ricordarti meno spesso e avere un obiettivo proprio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつもの設定は仕事の日のものです。休日は開始を遅くしたり、通知を減らしたり、別の目標を設定したりできます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gewone instellingen beschrijven een werkdag. Vrije dagen kunnen later beginnen, minder vaak herinneren en een eigen doel hebben."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus ajustes habituais descrevem um dia de trabalho. Dias de folga podem começar mais tarde, lembrar menos e ter objetivo próprio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常规设置对应工作日。休息日可以晚点开始、减少提醒，并设置单独目标。"
          }
        }
      }
    },
