    "Higher on sports days, lower on weekends. Days without their own goal use the daily goal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höher an Sporttagen, niedriger am Wochenende. Tage ohne eigenes Ziel nutzen das Tagesziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más alto los días de deporte, más bajo el fin de semana. Los días sin objetivo propio usan el objetivo diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus haut les jours de sport, plus bas le week-end. Les jours sans objectif propre prennent l'objectif quotidien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più alto nei giorni di sport, più basso nel weekend. I giorni senza un obiettivo proprio usano quello giornaliero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運動する日は高く、週末は低く。個別の目標がない曜日は1日の目標を使います。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoger op sportdagen, lager in het weekend. Dagen zonder eigen doel gebruiken het dagelijkse doel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais alto nos dias de esporte, mais baixo no fim de semana. Dias sem objetivo próprio usam o objetivo diário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运动日更高，周末更低。没有单独目标的日子使用每日目标。"
          }
        }
      }
    },
