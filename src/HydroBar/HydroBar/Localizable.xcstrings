    "Reminders follow your active hours, stop once your goal is reached, and come a bit more often when you're behind.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen folgen deinen aktiven Stunden, enden, sobald dein Ziel erreicht ist, und kommen etwas häufiger, wenn du im Rückstand bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios siguen tus horas activas, se detienen al alcanzar tu objetivo y llegan algo más a menudo cuando vas con retraso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels suivent votre plage active, s'arrêtent une fois l'objectif atteint, et arrivent un peu plus souvent quand vous êtes en retard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria seguono le tue ore attive, si fermano quando raggiungi l'obiettivo e arrivano un po' più spesso quando sei indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーはアクティブな時間帯に従い、目標を達成すると止まり、遅れているときは少し頻繁になります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen volgen je actieve uren, stoppen zodra je doel is bereikt en komen iets vaker als je achterloopt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes seguem suas horas ativas, param quando você atinge o objetivo e chegam um pouco mais vezes quando você está atrasado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒会遵循你的活跃时段，达成目标后停止，进度落后时会更频繁一些。"
          }
        }
      }
    },
