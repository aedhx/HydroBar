          }
        }
      }
    },
    "You often log %@. Make it a preset?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du trägst oft %@ ein. Als Voreinstellung speichern?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registras %@ a menudo. ¿Convertirlo en preajuste?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ajoutez souvent %@. En faire un preset ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registri spesso %@. Vuoi farne un preset?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をよく記録しています。プリセットにしますか？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je registreert vaak %@. Er een voorinstelling van maken?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você registra %@ com frequência. Transformar em predefinição?"
          }
        },
