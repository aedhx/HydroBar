          }
        }
      }
    },
    "You reached your daily goal. Well done!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dein Tagesziel erreicht. Gut gemacht!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado tu objetivo diario. ¡Bien hecho!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint votre objectif du jour. Bravo !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il tuo obiettivo giornaliero. Ben fatto!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日の目標を達成しました。よくできました！"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je dagelijkse doel bereikt. Goed gedaan!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você alcançou seu objetivo diário. Muito bem!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已达成今日目标。干得好！"
          }
        }
      }
    },
    "You're at %@ of %@. By now, you'd ideally be at %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You're at %1$@ of %2$@. By now, you'd ideally be at %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist bei %1$@ von %2$@. Zu dieser Zeit wärst du idealerweise bei %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevas %1$@ de %2$@. A esta hora, lo ideal sería %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous en êtes à %1$@ sur %2$@. À cette heure-ci, l'idéal serait %3$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei a %1$@ di %2$@. A quest'ora, l'ideale sarebbe %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在 %2$@ 中 %1$@。この時間の目安は %3$@ です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zit op %1$@ van %2$@. Op dit moment zou je idealiter op %3$@ zitten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está em %1$@ de %2$@. A esta hora, o ideal seria %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已喝 %1$@ / %2$@。此时理想情况下应达到 %3$@。"
          }
        }
      }
    },
    "You're behind your pace for today. Time for a glass!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du liegst heute hinter deinem Tempo. Zeit für ein Glas!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas por detrás de tu ritmo de hoy. ¡Hora de un vaso!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes en retard sur votre allure du jour. C'est l'heure d'un verre !"
          }
        },
        "it": {
