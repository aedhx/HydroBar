    "Restoring adds the entries you don't have yet: importing the same backup twice changes nothing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wiederherstellen werden nur fehlende Einträge hinzugefügt: Dieselbe Sicherung zweimal zu importieren ändert nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar añade los registros que aún no tienes: importar dos veces la misma copia no cambia nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration ajoute les entrées que vous n'avez pas encore : importer deux fois la même sauvegarde ne change rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripristino aggiunge le voci che non hai ancora: importare due volte lo stesso backup non cambia nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元では未登録の記録だけが追加されます。同じバックアップを2回読み込んでも変わりません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstellen voegt alleen items toe die je nog niet hebt: dezelfde reservekopie twee keer importeren verandert niets."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar adiciona apenas os registros que você ainda não tem: importar o mesmo backup duas vezes não muda nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复只会添加你还没有的记录：重复导入同一个备份不会有任何变化。"
          }
        }
      }
    },
