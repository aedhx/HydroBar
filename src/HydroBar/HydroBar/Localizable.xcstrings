    "%@ was unreadable and has been set aside as %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ war nicht lesbar und wurde als %2$@ beiseitegelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no se podía leer y se ha apartado como %2$@."
