    "Focus status is unreadable. Check that HydroBar is allowed to send notifications — the Focus status also needs it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fokusstatus ist nicht lesbar. Prüfe, ob HydroBar Mitteilungen senden darf – der Fokusstatus benötigt das ebenfalls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer el estado de concentración. Comprueba que HydroBar puede enviar notificaciones: el estado de concentración también lo necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'état de concentration est illisible. Vérifiez que HydroBar est autorisé à envoyer des notifications — l'état de concentration en a aussi besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato Full immersion non è leggibile. Verifica che HydroBar possa inviare notifiche: ne ha bisogno anche lo stato Full immersion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中モードの状態を読み取れません。HydroBar に通知の送信が許可されているか確認してください。集中モードの状態にも必要です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De focusstatus is onleesbaar. Controleer of HydroBar meldingen mag sturen – de focusstatus heeft dat ook nodig."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ler o estado de foco. Verifique se o HydroBar pode enviar notificações — o estado de foco também precisa disso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取专注模式状态。请确认已允许 HydroBar 发送通知 — 专注模式状态也需要此权限。"
          }
        }
      }
    },
