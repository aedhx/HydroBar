            "state": "translated",
            "value": "%1$@ não pôde ser lido e foi guardado à parte como %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 %1$@，已将其另存为 %2$@。"
          }
        }
      }
    },
