    "HydroBar shows your progress toward it all day, right in the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroBar zeigt dir den ganzen Tag deinen Fortschritt direkt in der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroBar te muestra tu progreso todo el día, directamente en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroBar affiche votre progression toute la journée, directement dans la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroBar mostra i tuoi progressi tutto il giorno, direttamente nella barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroBar がメニューバーで一日中進捗を表示します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroBar toont je voortgang de hele dag, direct in de menubalk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O HydroBar mostra seu progresso o dia todo, direto na barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroBar 会全天在菜单栏中显示你的进度。"
          }
        }
      }
    },
    "HydroBar will use the new language the next time it opens.": {
